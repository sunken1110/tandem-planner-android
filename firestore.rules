rules_version = '2';

// Security rules for Tandem Planner.
// Paste into Firebase console → Firestore Database → Rules, then Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    // A shared calendar ("room") for at most two people.
    match /rooms/{roomId} {
      // Only members can read the room.
      allow read: if signedIn()
        && request.auth.uid in resource.data.members;

      // The creator must be the only initial member.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid];

      // Join / rename:
      // - only `members` and `names` may change
      // - at most two members, nobody can be removed, and the caller must be a member afterwards
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
        && request.resource.data.members.size() <= 2
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members;

      // Events: only the two members can read, write and delete.
      match /events/{eventId} {
        allow read, delete: if isMember(roomId);
        allow create, update: if isMember(roomId)
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.date is string;
      }
    }
  }
}
