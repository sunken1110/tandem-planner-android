rules_version = '2';

// Security rules for Tandem Planner.
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// What these rules guarantee:
// - A room has at most two members; nobody can be removed, the creator stays first
//   (member order decides each person's color), and a newcomer can only add themselves.
//   The only exception is a seat recovery (below): a seat passes from a member's old
//   account to their new one, in place, and only with that seat's recovery code.
// - Each member can only set their own display name.
// - Events can only be created in your own name, the author never changes, and the
//   edit-history fields ("edited by", "original") can't be forged, hidden or rewritten.
// - Every field has a fixed type and size, so a bad write can't crash the other phone.
// - After a reinstall, a member can take back their own seat with their recovery
//   code (only its hash is stored here), and keeps authorship of their events.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(roomId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomId)).data.members;
    }

    // ── Rooms ──

    // A display name: 1–12 characters (AppConfig.MAX_NAME_LENGTH).
    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 12;
    }

    // A recovery-code hash: the raw 32-byte SHA-256 of the code's secret.
    // (Only the hash is stored; the code itself stays on the member's phone.)
    function validHash(h) {
      return h is bytes && h.size() == 32;
    }

    // `names` may only change at the caller's own key, to a valid name.
    function namesChangeOk() {
      let before = resource.data.names;
      let after = request.resource.data.names;
      return after is map
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || validName(after[request.auth.uid]));
    }

    // `members` stays the same, or the caller appends themselves.
    function membersChangeOk() {
      let before = resource.data.members;
      let after = request.resource.data.members;
      return after is list
        && after.size() <= 2
        && (after == before || after == before.concat([request.auth.uid]));
    }

    // `recovery` may only change at the caller's own key, to a valid hash.
    function recoveryChangeOk() {
      let before = resource.data.get('recovery', {});
      let after = request.resource.data.get('recovery', {});
      return after is map
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || validHash(after[request.auth.uid]));
    }

    // Join / rename / set your own recovery code.
    function memberUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'names', 'recovery'])
        && membersChangeOk()
        && namesChangeOk()
        && recoveryChangeOk()
        && request.auth.uid in request.resource.data.members;
    }

    // True when `secret` is the recovery code of the member at `seat` (0 or 1).
    function secretMatches(room, seat, secret) {
      let recovery = room.get('recovery', {});
      return seat is int && seat >= 0 && seat < room.members.size()
        && room.members[seat] in recovery
        && secret is string && secret.size() <= 32
        && hashing.sha256(secret) == recovery[room.members[seat]];
    }

    function claimPath(roomId) {
      return /databases/$(database)/documents/rooms/$(roomId)/claims/$(request.auth.uid);
    }

    // The caller has proven a recovery code for this room (see /claims below).
    function hasValidClaim(roomId, room) {
      return exists(claimPath(roomId))
        && secretMatches(room, get(claimPath(roomId)).data.seat, get(claimPath(roomId)).data.secret);
    }

    // Seat recovery: after a reinstall (new anonymous account), the caller takes
    // over the seat whose recovery code they proved. Exactly that seat changes
    // hands; its name and recovery entry move to the caller (with a new hash), and
    // `formerUids` records old → new so the old account's events stay theirs.
    function claimUpdateOk(roomId) {
      let me = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      let claim = get(claimPath(roomId)).data;
      let seat = claim.seat;
      let old = before.members[seat];
      let size = before.members.size();
      let recoveryAfter = after.get('recovery', {});
      let formerAfter = after.get('formerUids', {});
      return exists(claimPath(roomId))
        && secretMatches(before, seat, claim.secret)
        && !(me in before.members)
        && after.diff(before).affectedKeys().hasOnly(['members', 'names', 'recovery', 'formerUids'])
        // Members: only this seat changes, to the caller.
        && ((seat == 0 && size == 1 && after.members == [me])
          || (seat == 0 && size == 2 && after.members == [me, before.members[1]])
          || (seat == 1 && after.members == [before.members[0], me]))
        // Names: the old account's name moves to the caller.
        && after.names.diff(before.names).affectedKeys().hasOnly([old, me])
        && !(old in after.names)
        && validName(after.names[me])
        // Recovery: the old hash is gone; the caller's new one is set.
        && recoveryAfter.diff(before.get('recovery', {})).affectedKeys().hasOnly([old, me])
        && !(old in recoveryAfter)
        && validHash(recoveryAfter[me])
        // Aliases: exactly one new entry, old → caller.
        && formerAfter.diff(before.get('formerUids', {})).affectedKeys().hasOnly([old])
        && formerAfter[old] == me;
    }

    // A shared calendar ("room") for at most two people.
    match /rooms/{roomId} {
      // Members can read the room; so can someone with a proven recovery code,
      // who needs to see the room to take over their seat.
      allow read: if signedIn()
        && (request.auth.uid in resource.data.members || hasValidClaim(roomId, resource.data));

      // The creator must be the only initial member, with only their own name
      // (and optionally their own recovery hash).
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'createdAt', 'recovery'])
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.names is map
        && request.resource.data.names.keys().hasOnly([request.auth.uid])
        && validName(request.resource.data.names[request.auth.uid])
        && (!('recovery' in request.resource.data)
          || (request.resource.data.recovery is map
            && request.resource.data.recovery.keys().hasOnly([request.auth.uid])
            && validHash(request.resource.data.recovery[request.auth.uid])));

      // Join / rename / recovery code, or a seat recovery.
      allow update: if signedIn() && (memberUpdateOk() || claimUpdateOk(roomId));

      // ── Recovery claims ──
      // To recover a seat, the caller first writes the code (seat + secret) here.
      // The rules only accept it if it matches that seat's stored hash, so this
      // doc existing proves the code. Only the caller can see or delete it.
      match /claims/{claimUid} {
        allow read, delete: if signedIn() && request.auth.uid == claimUid;
        allow create, update: if signedIn() && request.auth.uid == claimUid
          && request.resource.data.keys().hasOnly(['seat', 'secret'])
          && secretMatches(
               get(/databases/$(database)/documents/rooms/$(roomId)).data,
               request.resource.data.seat,
               request.resource.data.secret);
      }

      // ── Events ──

      match /events/{eventId} {

        // Field types and sizes. `time` is "HH:mm", blank, or a short free-form
        // value written by early app versions.
        function validEvent(d) {
          return d.keys().hasOnly([
              'date', 'time', 'title', 'authorUid', 'authorName', 'createdAt',
              'updatedAt', 'editedByUid', 'editedByName', 'original'
            ])
            && d.date is string && d.date.size() == 10
            && d.time is string && d.time.size() <= 20
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 200
            && d.authorUid is string
            && d.authorName is string && d.authorName.size() <= 40
            && (!('editedByUid' in d) || d.editedByUid is string)
            && (!('editedByName' in d) || (d.editedByName is string && d.editedByName.size() <= 40))
            && (!('original' in d) || d.original is map);
        }

        // The editable part of an event, in the same shape as `original`.
        function editable(d) {
          return { 'date': d.date, 'time': d.time, 'title': d.title };
        }

        function hasMarks(d) {
          return ('editedByUid' in d) || ('original' in d);
        }

        // An edit by the member who is NOT the author. Either:
        // - it is marked: "edited by" is the caller, and `original` is the author's
        //   version (copied on the first such edit, unchanged afterwards); or
        // - it is unmarked: allowed only when it equals the author's version again.
        function otherMemberEditOk() {
          let before = resource.data;
          let after = request.resource.data;
          let hadOriginal = 'original' in before;
          return hasMarks(after)
            ? (after.editedByUid == request.auth.uid
                && after.editedByName is string
                && ((hadOriginal && after.original == before.original)
                  || (!hadOriginal && after.original == editable(before))))
            : ((hadOriginal && editable(after) == before.original)
                || (!hadOriginal && editable(after) == editable(before)));
        }

        // True when the caller is the event's author, or the account that took over
        // the author's seat after a reinstall (followed through up to two recoveries).
        function isAuthor(authorUid) {
          let aliases = get(/databases/$(database)/documents/rooms/$(roomId)).data.get('formerUids', {});
          let once = aliases.get(authorUid, '');
          return request.auth.uid == authorUid
            || request.auth.uid == once
            || (once != '' && request.auth.uid == aliases.get(once, ''));
        }

        allow read, delete: if isMember(roomId);

        // New events: in your own name, without edit marks.
        allow create: if isMember(roomId)
          && validEvent(request.resource.data)
          && request.resource.data.authorUid == request.auth.uid
          && !hasMarks(request.resource.data);

        // Edits: the author and creation time never change. The author's own edit
        // clears the marks (their version counts); the other member's edit is marked.
        allow update: if isMember(roomId)
          && validEvent(request.resource.data)
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['authorUid', 'authorName', 'createdAt'])
          && (isAuthor(resource.data.authorUid)
                ? !hasMarks(request.resource.data)
                : otherMemberEditOk());
      }
    }
  }
}
