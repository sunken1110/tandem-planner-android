<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget-list preview (Android 12+) of the 2x1 card, with sample content.
  Widget layouts may only use RemoteViews-supported views (FrameLayout,
  LinearLayout, TextView, ImageView, ...); a plain View fails to load.
  Sample texts are written in place on purpose (preview only), so lint's
  "HardcodedText" warning is turned off here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <FrameLayout
        android:layout_width="3dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_preview_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음 일정"
            android:textColor="#B32B2622"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="하와이 여행"
            android:textColor="#2B2622"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="2/9 ~ 2/12 · 하윤"
            android:textColor="#B32B2622"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_preview_pill"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="D-1"
        android:textColor="#953050"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
