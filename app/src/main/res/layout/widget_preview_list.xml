<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget-list preview (Android 12+) of the 2x2 list, with sample content: the
  same moment as the other previews (Feb 8, the trip is D-1), so the list only
  holds events after the trip.
  Sample texts are written in place on purpose (preview only), so lint's
  "HardcodedText" warning is turned off here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="3dp"
            android:layout_height="42dp"
            android:background="@drawable/widget_preview_bar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="다음 일정"
                android:textColor="#B32B2622"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="하와이 여행"
                android:textColor="#2B2622"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="2/9 ~ 2/12 · 하윤"
                android:textColor="#B32B2622"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="D-1"
            android:textColor="#953050"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="#F3C98A" />

    <!-- Day · author dot · time (lighter, fixed width) · title, as in the real widget. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="2/14"
            android:textColor="#2B2622"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/widget_preview_dot_violet" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="종일"
            android:textColor="#8C2B2622"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="발렌타인데이"
            android:textColor="#2B2622"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Day · author dot · time (lighter, fixed width) · title, as in the real widget. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="2/17"
            android:textColor="#2B2622"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/widget_preview_dot_pink" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="19:00"
            android:textColor="#8C2B2622"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="여행 사진 정리"
            android:textColor="#2B2622"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
